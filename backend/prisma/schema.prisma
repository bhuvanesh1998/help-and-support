// ============================================================================
//  In-App Tutorial & Help Assistant — Prisma Schema
//  Database: PostgreSQL  |  Client: Prisma ORM 7 (Rust-free)
//
//  Phase 1 ships the full relational core. The Analytics, Media, and SEO
//  surfaces are modelled now (not retrofitted later) so the admin analytics,
//  media server, and SEO/AI-SEO features in Phases 2-4 require no destructive
//  migrations.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
//  Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum AnalyticsEventType {
  PAGE_VIEW
  HELP_OPENED
  HELP_CLOSED
  STEP_VIEWED
  STEP_COMPLETED
  TUTORIAL_COMPLETED
  SEARCH
  LINK_CLICK
}

// ---------------------------------------------------------------------------
//  Identity & Access (Backoffice)
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  /// Account tier. SUPER_ADMIN always has every permission regardless of role,
  /// so the instance can never be locked out of its own administration.
  role         UserRole  @default(ADMIN)
  /// Assigned role, which decides the feature permissions. Null falls back to
  /// the legacy ADMIN set (everything except users and roles).
  roleId       String?   @db.Uuid
  accessRole   Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  /// Bumped to invalidate every token already issued to this account — logout
  /// everywhere, and any password change. Tokens carry the value they were
  /// signed with and are rejected once it no longer matches.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedMedia MediaAsset[] @relation("UploadedByUser")

  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
//  Trash: deleted records held for a retention window, restorable until purged
// ---------------------------------------------------------------------------

/// A deleted record, kept whole so it can be put back.
///
/// The rows are *removed* from their own tables and serialised into `payload`
/// rather than being flagged in place. That keeps every existing list, count and
/// join correct without a `deletedAt IS NULL` filter threaded through the app —
/// a filter missed in one query is how "deleted" content reappears.
model TrashItem {
  id          String   @id @default(uuid()) @db.Uuid
  /// Which adapter can restore this: 'voiceoverScript' | 'page' | 'category'.
  entityType  String
  /// The original record's id, so a restore recreates it unchanged.
  entityId    String
  /// What the user sees in the trash list.
  label       String
  description String   @default("")
  /// The record and its children, exactly as they were.
  payload     Json
  deletedById String?  @db.Uuid
  deletedAt   DateTime @default(now())
  /// Stamped at delete time, so changing the retention window never silently
  /// re-dates what is already in the trash.
  expiresAt   DateTime

  @@index([expiresAt])
  @@index([entityType])
  @@map("trash_items")
}

// ---------------------------------------------------------------------------
//  Roles: a named set of feature permissions, assignable to users
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  /// Permission keys from src/config/permissions.ts, stored expanded (implied
  /// keys included) so a check is a plain membership test.
  permissions String[]
  /// Seeded roles: renameable, but their permissions and existence are fixed so
  /// there is always a coherent role to fall back on.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
//  Content: a Page maps a front-end route to an ordered set of tutorial steps
// ---------------------------------------------------------------------------

model Page {
  id          String  @id @default(uuid()) @db.Uuid
  routePath   String  @unique // e.g. '/dashboard/settings'
  slug        String? @unique // public help-center URL segment (SEO)
  title       String
  description String?

  // Module grouping for the help-center landing & admin list.
  category      String? // e.g. 'Chat', 'Campaigns', 'Configuration'
  categoryOrder Int     @default(99) // section order on the landing page

  // Publish state. Off (false) hides the manual from the end-user help center
  // (public API) while keeping it fully editable in the admin so it can be
  // reworked and switched back on. Defaults to live for backward compatibility.
  isPublished Boolean @default(true)

  // --- SEO / AI-SEO metadata (consumed by SSR + JSON-LD in Phase 3/4) ---
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])
  canonicalUrl    String?
  ogImageUrl      String?
  noIndex         Boolean  @default(false)
  structuredData  Json? // JSON-LD payload for rich results & answer engines

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps        TutorialStep[]
  apiEndpoints ApiEndpoint[]
  events       AnalyticsEvent[]

  @@index([slug])
  @@map("pages")
}

// ---------------------------------------------------------------------------
//  Module categories — manage the help-center groupings from the admin.
//  Pages reference a category by name (Page.category); renames cascade.
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  order       Int      @default(99)
  icon        String? // Material icon name shown on the landing summary card
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model TutorialStep {
  id             String   @id @default(uuid()) @db.Uuid
  pageId         String   @db.Uuid
  stepNumber     Int
  title          String
  instructionsMd String   @db.Text // Markdown source
  imageUrl       String? // resolved public URL (denormalised for fast reads)
  mediaAssetId   String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page       Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  events     AnalyticsEvent[]

  // Prevents two steps claiming the same position within one page.
  @@unique([pageId, stepNumber])
  @@index([pageId])
  @@map("tutorial_steps")
}

// ---------------------------------------------------------------------------
//  API reference for a screen. Auto-captured from the live network traffic the
//  screen makes during a browser capture (method/path/status/response sample),
//  then curatable in the admin. Rendered in the "API" tab of each user manual.
// ---------------------------------------------------------------------------

model ApiEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  pageId         String   @db.Uuid
  method         String // GET, POST, PUT, PATCH, DELETE, WS, ...
  path           String // e.g. /api/chat/active
  query          String? // raw query string, without leading '?'
  host           String? // origin host when cross-origin; null = same as the app
  requestBody    String?  @db.Text // captured request payload (truncated)
  status         Int? // response status code
  contentType    String? // response content-type
  responseSample String?  @db.Text // truncated response body sample
  description    String? // optional curation note authored in the admin
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("api_endpoints")
}

// ---------------------------------------------------------------------------
//  AI provider credentials (e.g. Anthropic) — set once, reused for every run.
//  The API key is stored encrypted at rest (AES-256-GCM); only a masked
//  last-4 preview and the validation timestamp are ever returned to clients.
// ---------------------------------------------------------------------------

model AiCredential {
  id           String    @id @default(uuid()) @db.Uuid
  provider     String    @unique // 'anthropic'
  encryptedKey String    // AES-256-GCM ciphertext (base64)
  iv           String    // base64 nonce
  authTag      String    // base64 GCM auth tag
  keyLast4     String    // masked preview for the UI, e.g. 'ab12'
  model        String    @default("claude-sonnet-4-6")
  validatedAt  DateTime? // last time the key passed an Anthropic check
  updatedById  String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("ai_credentials")
}

// ---------------------------------------------------------------------------
//  MCP connector: a bearer token a Claude host (Claude Code / Desktop /
//  claude.ai) uses to reach the in-app MCP server. The token is stored
//  encrypted at rest (AES-256-GCM); only a masked last-4 is returned in status.
// ---------------------------------------------------------------------------

model McpConnector {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique // 'default'
  encryptedToken  String   // AES-256-GCM ciphertext (base64)
  iv              String   // base64 nonce
  authTag         String   // base64 GCM auth tag
  tokenLast4      String   // masked preview for the UI
  enabled         Boolean  @default(true)
  updatedById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mcp_connectors")
}

// ---------------------------------------------------------------------------
//  Embeddable Help widget configuration — the saved defaults used by /widget.js
//  and the demo page. A single row ("default"); not secret, stored in clear.
// ---------------------------------------------------------------------------

model WidgetConfig {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @default("default")
  launcher    String   @default("fab")           // fab | tab | pill
  icon        String   @default("question")      // question | chat | book | bulb | info | none
  label       String   @default("Need some help?")
  animation   String   @default("slide")         // slide | slide-side | scale | fade | none
  position    String   @default("right")         // right | left
  color       String   @default("#2e6f6a")
  theme       String   @default("auto")           // auto | light | dark
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("widget_configs")
}

// ---------------------------------------------------------------------------
//  Document exports: server-generated Word/PDF bundles of selected tutorials,
//  produced asynchronously and downloaded from the admin "Exports" screen.
// ---------------------------------------------------------------------------

model Export {
  id            String    @id @default(uuid()) @db.Uuid
  format        String    // 'pdf' | 'doc'
  status        String    @default("pending") // pending | ready | error
  title         String    // human label, e.g. "2 tutorials"
  pageCount     Int       @default(0)
  progress      Int       @default(0) // tutorials whose content has been assembled
  filename      String?   // stored file name on disk
  sizeBytes     Int?
  error         String?
  requestedById String?   @db.Uuid
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([createdAt])
  @@map("exports")
}

// ---------------------------------------------------------------------------
//  Media server: every uploaded screenshot is a first-class, addressable asset
// ---------------------------------------------------------------------------

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  filename     String   @unique // server-side stored name (collision-safe)
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  storagePath  String // path on disk / object-store key
  publicUrl    String // absolute URL served to clients
  altText      String?
  checksum     String? // sha-256 for de-duplication & integrity
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  // --- Annotation editor (non-destructive) ---
  // The untouched base image is preserved on first edit; each save re-renders
  // the annotation layer over it, so edits are reversible and re-editable.
  annotations         Json?     // editable vector shapes drawn over the image
  originalStoragePath String?   // disk path of the untouched base (set on first edit)
  originalUrl         String?   // public URL of the untouched base
  editedAt            DateTime? // last annotation save

  // --- Trash (soft delete) ---
  // When set, the asset is in the trash; a lazy sweep purges rows whose
  // deletedAt is older than the 30-day retention window on the next list load.
  deletedAt DateTime? // moved-to-trash timestamp; null = live

  uploadedBy User?          @relation("UploadedByUser", fields: [uploadedById], references: [id], onDelete: SetNull)
  steps      TutorialStep[]

  @@index([uploadedById])
  @@index([deletedAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
//  Analytics & user tracing (privacy-first: IPs are stored only as salted hash)
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id             String             @id @default(uuid()) @db.Uuid
  eventType      AnalyticsEventType
  routePath      String?
  pageId         String?            @db.Uuid
  tutorialStepId String?            @db.Uuid
  sessionId      String? // rotating client session identifier
  anonymousId    String? // stable pseudonymous visitor id
  userAgent      String?
  referrer       String?
  ipHash         String? // salted SHA-256 of IP — never the raw address
  country        String?
  durationMs     Int?
  metadata       Json?
  createdAt      DateTime           @default(now())

  page         Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  tutorialStep TutorialStep? @relation(fields: [tutorialStepId], references: [id], onDelete: SetNull)

  @@index([eventType])
  @@index([routePath])
  @@index([pageId])
  @@index([createdAt])
  @@map("analytics_events")
}

/// Runtime-editable Voiceover Studio tunables. A single row ("default").
/// When absent, the values fall back to the environment defaults, so a fresh
/// deployment behaves exactly as before this table existed.
model VoiceoverSetting {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique @default("default")
  maxVideoUploadMb    Int      @default(500)
  provider            String   @default("anthropic") // anthropic | openai | gemini
  model               String   @default("claude-opus-5")
  effort              String   @default("medium")   // low | medium | high | xhigh | max
  maxTokens           Int      @default(12000)
  maxFrames           Int      @default(48)
  framesPerBatch      Int      @default(12)
  frameWidth          Int      @default(960)
  frameQuality        Int      @default(4)          // ffmpeg -q:v, 1 best … 31 worst
  sceneThreshold      Float    @default(0.3)        // 0–1, lower catches more transitions
  minFrameGapSec      Float    @default(1.5)
  minSegmentSec       Float    @default(4)
  maxSegmentSec       Float    @default(14)
  wordsPerMinute      Int      @default(150)
  jobRetentionMinutes Int      @default(60)
  updatedById         String?  @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("voiceover_settings")
}

/// A generated voiceover script, kept so the output survives navigation,
/// job expiry and restarts. One row per run; segments are children.
model VoiceoverScript {
  id           String   @id @default(uuid()) @db.Uuid
  videoName    String
  appName      String
  audience     String
  tone         String
  provider     String
  model        String
  /// Source video facts, for the review header.
  durationSec  Float    @default(0)
  width        Int      @default(0)
  height       Int      @default(0)
  fps          Float    @default(0)
  sizeBytes    Int      @default(0)
  /// Speaking pace this run used — word budgets are meaningless without it.
  wordsPerMinute Int    @default(150)
  frameCount   Int      @default(0)
  totalWords   Int      @default(0)
  /// running | done | error | cancelled
  status       String   @default("running")
  error        String?
  /// Set when this run re-used another script's frames with a different tone,
  /// so every tone of one video groups together as variants.
  sourceScriptId String? @db.Uuid
  createdById  String?  @db.Uuid
  /// The voice this script is narrated in. Pinned on the first render so every
  /// later take — including a re-record months later — matches, rather than
  /// following whatever the voice dropdown happened to show.
  voiceId      String?
  voiceName    String?
  ttsModelId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  segments VoiceoverSegment[]
  segmentVersions VoiceoverSegmentVersion[]
  frames   VoiceoverFrame[]
  audio    VoiceoverAudio[]
  source   VoiceoverScript?  @relation("ScriptVariants", fields: [sourceScriptId], references: [id], onDelete: SetNull)
  variants VoiceoverScript[] @relation("ScriptVariants")

  @@index([createdAt])
  @@index([sourceScriptId])
  @@map("voiceover_scripts")
}

/// The sampled stills for a run, kept so a different tone can be generated
/// without re-uploading the video (the upload is deleted after extraction).
model VoiceoverFrame {
  id            String   @id @default(uuid()) @db.Uuid
  scriptId      String   @db.Uuid
  at            Float
  isSceneChange Boolean  @default(false)
  imageUrl      String?
  /// On-disk path, needed to re-read the bytes when regenerating.
  storagePath   String
  createdAt     DateTime @default(now())

  scriptRecord VoiceoverScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([scriptId])
  @@map("voiceover_frames")
}

/// One narration segment, locked to a span of the source video.
model VoiceoverSegment {
  id         String   @id @default(uuid()) @db.Uuid
  scriptId   String   @db.Uuid
  index      Int
  startSec   Float
  endSec     Float
  onScreen   String
  script     String
  wordBudget Int
  wordCount  Int
  imageUrl   String?
  /// Set when a human rewrote this line, so edits are visible as such.
  editedAt   DateTime?
  /// Which stored version `script` currently holds. Rendered audio is filed
  /// against the version it was spoken from, so restoring a version brings its
  /// audio back instead of requiring a re-record.
  version    Int      @default(1)
  createdAt  DateTime @default(now())

  scriptRecord VoiceoverScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, index])
  @@index([scriptId])
  @@map("voiceover_segments")
}

/// Every wording a line has ever had. Append-only: an edit adds a version rather
/// than overwriting, so a rewrite is never a one-way door.
model VoiceoverSegmentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  scriptId     String   @db.Uuid
  segmentIndex Int
  version      Int
  text         String
  wordCount    Int      @default(0)
  /// 'generated' for the model's wording, 'edited' for a human rewrite.
  source       String   @default("generated")
  createdAt    DateTime @default(now())

  scriptRecord VoiceoverScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, segmentIndex, version])
  @@index([scriptId, segmentIndex])
  @@map("voiceover_segment_versions")
}

/// Rendered narration audio, one row per script segment. Keyed by segment index
/// so re-rendering a single line replaces just that clip.
model VoiceoverAudio {
  id           String   @id @default(uuid()) @db.Uuid
  scriptId     String   @db.Uuid
  /// 'segment' for one line; 'timeline' for the full-length stitched track,
  /// which is stored at segmentIndex -1.
  kind         String   @default("segment")
  segmentIndex Int
  voiceId      String
  voiceName    String
  modelId      String
  filename     String
  storagePath  String
  publicUrl    String
  sizeBytes    Int      @default(0)
  /// The segment version this clip was spoken from. For a stitched timeline this
  /// is the build number instead, so earlier mixes are kept as history. Clips are
  /// kept per version so editing a line no longer throws its recording away.
  segmentVersion Int    @default(1)
  /// Timeline rows only: the `index:version` pairs mixed into this track. Compared
  /// against the script to tell whether the track still matches the words.
  sourceSignature String?
  createdAt    DateTime @default(now())

  scriptRecord VoiceoverScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, segmentIndex, segmentVersion])
  @@index([scriptId])
  @@map("voiceover_audio")
}

/// One row per billable API call the Voiceover Studio makes, so usage can be
/// reported per provider, model and script. Units are recorded raw (tokens,
/// characters, requests) rather than priced — provider rates change, and a
/// wrong hardcoded price is worse than no price.
model VoiceoverUsage {
  id           String   @id @default(uuid()) @db.Uuid
  /// Deliberately not a foreign key: deleting a script must not erase what it
  /// cost. The report shows such rows without a name.
  scriptId     String?  @db.Uuid
  /// 'script' for a vision call, 'tts' for narration audio, 'sample' for an
  /// audition. Timeline assembly is local ffmpeg work and is not recorded.
  kind         String
  provider     String
  model        String
  /// Vision calls: tokens reported by the provider.
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Vision calls: how many stills were sent in this request.
  frames       Int      @default(0)
  /// TTS calls: characters submitted, which is what ElevenLabs bills on.
  characters   Int      @default(0)
  /// False when the call failed; kept so failures are visible in the report.
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([scriptId])
  @@index([provider, kind])
  @@map("voiceover_usage")
}
