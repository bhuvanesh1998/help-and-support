# ── Local development environment for the Help Assistant backend ─────────────
# Copy to backend/.env (gitignored) and fill in the secrets:
#   cp backend/.env.example backend/.env

NODE_ENV=development
PORT=3000

# Public origin of this API (used for media URLs + the widget loader).
PUBLIC_BASE_URL=http://localhost:3000

# Allowed browser origins (comma-separated). The Angular dev server by default.
CORS_ORIGIN=http://localhost:4200

# Origins allowed to FRAME the /embed help panel (space-separated, CSP
# frame-ancestors). '*' = any site may embed the widget.
EMBED_ALLOWED_ORIGINS=*

# Matches the defaults in docker-compose.yml (`docker compose up -d db`).
# Change the password here AND via POSTGRES_PASSWORD when starting the container.
DATABASE_URL=postgresql://help_admin:replace_with_a_strong_password@localhost:5432/help_assistant?schema=public

# Auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE-ME-64-PLUS-HEX-CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts at-rest secrets (stored API key, MCP token). Defaults to JWT_SECRET.
# SETTINGS_ENCRYPTION_KEY=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Initial super admin created by `npm run db:seed` (password: 12+ characters).
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=CHANGE-ME-12-PLUS-CHARS
